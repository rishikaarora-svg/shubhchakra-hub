# Server-only (no VITE_ prefix, so Vite never bundles it). Set the same vars in Vercel → Project → Environment Variables.
GEMINI_API_KEY=
# gemini-1.5/2.5-flash are retired for new keys. flash-lite answers in ~1.1 s, inside the 1.5 s guardrail
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: extra origins allowed to call /api/analyze-waste, comma-separated (same-site calls are always allowed)
ALLOWED_ORIGINS=
# Client stage guardrail: abort the live call after this many ms and fall back to on-device analysis
VITE_GEMINI_TIMEOUT_MS=1500
